{
  "name": "JenkinsMonitor",
  "version": "0.0.9",
  "description": "An Electron app to monitor Jenkins radiators",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "release": "electron-builder",
    "test": "echo success",
    "build": "electron-packager . JenkinsMonitor --overwrite --ignore=\"^/(dist|build|release-builds|snapshot|snapshot2)(/|$)\" --icon=./jenkins.icns --out=build --extraResources=[jenkins.png,jenkinsfire.png]",
    "build-snapshot": "electron-packager . JenkinsMonitor-$npm_package_version --overwrite --ignore=\"^/(dist|build|release-builds|snapshot|snapshot2)(/|$)\" --icon=./jenkins.icns --out=snapshot2 --extraResources=[jenkins.png,jenkinsfire.png]",
    "package-win": "electron-packager . JenkinsMonitor --overwrite --asar --platform=win32 --arch=x64 --ignore=\"^/(dist|build|release-builds|snapshot|snapshot2)(/|$)\" --icon=jenkins.ico --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"Jenkins Monitor\""
  },
  "repository": "https://github.com/micronaut/electron-jenkins-monitor",
  "keywords": [
    "Electron",
    "Jenkins"
  ],
  "author": "Eric Danowski",
  "build": {
    "appId": "electron.jenkins.monitor",
    "publish": "github",
    "files": [
      "!**/.git/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!src",
      "!dist/**",
      "!build/**",
      "!release-builds/**",
      "!snapshot/**",
      "!snapshot2/**",
      "!coverage",
      "!docs"
    ],
    "mac": {
      "target": "dmg"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "appImage": {
      "license": "LICENSE"
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "license": "LICENSE"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "CC0-1.0",
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  }
}
